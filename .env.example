# Copy to .env.local for local development, and set the same names in
# Vercel → Project → Settings → Environment Variables for production.
# Never commit real values. See docs/ADMIN.md.

# --- Admin login (all three required, otherwise every login is refused) ---
# Login email.
ADMIN_EMAIL=
# Password hash, never the password itself. Generate it with:
#   node scripts/hash-admin-password.mjs
# Format: scrypt:<salt>:<hash>
ADMIN_PASSWORD_HASH=
# Random string of 32+ characters that signs the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing it signs the admin out everywhere.
ADMIN_SESSION_SECRET=

# --- Content storage ---
# Vercel Blob read-write token. Added automatically when a Blob store is
# connected to the project. Without it: local dev saves to .data/ and
# public/uploads/; on Vercel the site shows the defaults and saving is refused.
BLOB_READ_WRITE_TOKEN=
# "public" (default) or "private". Keep "public" unless the store is private.
BLOB_ACCESS=public

# --- Indexing (optional) ---
# Vercel production is indexable automatically. Set to true only when hosting
# the production site outside Vercel.
NEXT_PUBLIC_INDEXABLE=
