# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules

# next.js
/.next/
/out/

# production
/build

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
# performance builds and local reports scratch
/.next-perf/
/.next-video-dev/

# admin content and uploads saved locally in development (production uses Vercel Blob)
/.data/
/public/uploads/

# client video originals (≈166 MB, kept unmodified, never served: the site
# plays the prepared copies in public/videos/) and the extracted delivery pack
/public/*.MOV
/public/*.mov
/abfastcar-client-integration/
/abfastcar-client-integration.zip

# Lighthouse runs and test captures: local evidence, too heavy for git
# (≈180 MB). The written summaries (.md) are kept.
/reports/**
!/reports/**/
!/reports/**/*.md
